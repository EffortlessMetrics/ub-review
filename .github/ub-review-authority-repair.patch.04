+fn proof_command_source(required: bool, phase: ProofExecutionPhase) -> TaskSource {
+    if required {
+        return TaskSource::Required;
+    }
+    match phase {
+        ProofExecutionPhase::InitialImpact => TaskSource::Impact,
+        ProofExecutionPhase::ModelRequest => TaskSource::ReviewerTurn { model_on: true },
+        ProofExecutionPhase::FollowUp => TaskSource::Configured,
+        ProofExecutionPhase::Worker => TaskSource::Worker,
+    }
+}
+
+pub(crate) fn standalone_worker_revision(request: &ProofRequestV2) -> Result<RevisionRef> {
+    ensure!(
+        !request.head.trim().is_empty(),
+        "standalone worker request has empty head identity"
+    );
+    let digest = sha256_hex(
+        format!(
+            "ub-review.worker-task-ledger.v1\0{}\0{}\0{}\0{}\0{}",
+            request.id,
+            request.kind.key(),
+            request.base,
+            request.head,
+            request.target,
+        )
+        .as_bytes(),
+    );
+    let revision = RevisionRef {
+        digest,
+        semantics: "candidate_head".to_owned(),
+        reviewed_commit: request.head.clone(),
+    };
+    revision.validate().context("standalone worker revision")?;
+    Ok(revision)
+}
