+    #[test]
+    fn unsupported_worker_request_terminalizes_without_spawning() -> Result<()> {
+        let temp = tempfile::tempdir()?;
+        let out = temp.path().join("out");
+        let args = WorkerArgs {
+            proof_request: temp.path().join("unused-request.json").display().to_string(),
+            root: temp.path().display().to_string(),
+            out: out.display().to_string(),
+            timeout_sec: 30,
+        };
+        let request = ProofRequestV2 {
+            schema: crate::artifacts::PROOF_REQUEST_V2_SCHEMA.to_owned(),
+            id: "unsupported-worker".to_owned(),
+            kind: ProofKind::SourceRouteProbe,
+            target: "src/main.rs".to_owned(),
+            claim_ids: Vec::new(),
+            requested_by: vec!["opposition".to_owned()],
+            expected_interpretation: "route existence is not an executable proof".to_owned(),
+            priority: "medium".to_owned(),
+            timeout_sec: 30,
+            status: "approved".to_owned(),
+            base: "a".repeat(40),
+            head: "b".repeat(40),
+        };
+        let mut runner_called = false;
+
+        run_worker_request_with_runner(
+            &args,
+            request,
+            &mut |_root, _argv, _env, _timeout, _stdout, _stderr, _observe_process| {
+                runner_called = true;
+                bail!("unsupported request must not execute")
+            },
+        )?;
+
+        ensure!(!runner_called);
+        let receipt: ProofReceipt =
+            serde_json::from_slice(&fs::read(out.join("proof_receipt.json"))?)?;
+        ensure!(receipt.result == "skipped_unresolved");
+        ensure!(receipt.commands.len() == 1);
+        ensure!(receipt.commands[0].status == "skipped");
+        let events = fs::read_to_string(out.join("task_ledger_events.ndjson"))?;
+        ensure!(events.contains("TerminallyDeclined"));
+        ensure!(!events.contains("RunStarted"));
+        Ok(())
+    }
+
+    #[test]
+    fn worker_setup_failure_releases_resources_with_explicit_failed_receipt() -> Result<()> {
+        let temp = tempfile::tempdir()?;
+        let out = temp.path().join("out");
+        let args = WorkerArgs {
+            proof_request: temp.path().join("unused-request.json").display().to_string(),
+            root: temp.path().display().to_string(),
+            out: out.display().to_string(),
+            timeout_sec: 30,
+        };
+        let request = ProofRequestV2 {
+            schema: crate::artifacts::PROOF_REQUEST_V2_SCHEMA.to_owned(),
+            id: "setup-failure-worker".to_owned(),
+            kind: ProofKind::FocusedTest,
+            target: "cargo test --locked worker_test".to_owned(),
+            claim_ids: vec!["claim-a".to_owned()],
+            requested_by: vec!["worker-test".to_owned()],
+            expected_interpretation: "setup failure remains explicit".to_owned(),
+            priority: "high".to_owned(),
+            timeout_sec: 30,
+            status: "approved".to_owned(),
+            base: "a".repeat(40),
+            head: "b".repeat(40),
+        };
+
+        run_worker_request_with_runner(
+            &args,
+            request,
+            &mut |_root, _argv, _env, _timeout, _stdout, _stderr, _observe_process| {
+                Err(anyhow::anyhow!("injected pre-spawn worker failure"))
+            },
+        )?;
+
+        let receipt: ProofReceipt =
+            serde_json::from_slice(&fs::read(out.join("proof_receipt.json"))?)?;
+        ensure!(receipt.commands[0].status == "skipped");
+        let snapshot: serde_json::Value = serde_json::from_slice(&fs::read(
+            out.join("review/task_ledger_snapshot.json"),
+        )?)?;
+        let task_id = proof_command_task_id("setup-failure-worker", "head")?;
+        let task = snapshot["tasks"]
+            .as_array()
+            .context("worker task snapshot array missing")?
+            .iter()
+            .find(|task| task["id"] == task_id.as_str())
+            .context("worker setup-failure task missing")?;
+        ensure!(task["state"] == serde_json::json!({"ResourcesReleased": "SetupFailed"}));
+        ensure!(task["receipt"]["Created"]["reference"] == "proof_receipt.json#/commands/0");
+        Ok(())
+    }
+
