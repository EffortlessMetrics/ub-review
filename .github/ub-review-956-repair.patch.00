+}
+
+fn run_worker_request_with_runner<F>(
+    args: &WorkerArgs,
+    request: ProofRequestV2,
+    runner: &mut F,
+) -> Result<()>
+where
+    F: FnMut(
+        &Path,
+        &[String],
+        &BTreeMap<String, String>,
+        u64,
+        &Path,
+        &Path,
+        &mut dyn FnMut(CommandProcessObservation),
+    ) -> Result<CommandStatus>,
+{
+    let out = Path::new(&args.out);
+    let root = Path::new(&args.root);
+    let revision = standalone_worker_revision(&request)?;
+    let recorder = TaskLedgerRecorder::new(&revision, &Instant::now())?;
+    let task_ledger = ProofTaskLedger::new(recorder);
+    let timeout_sec = args.timeout_sec.max(request.timeout_sec).max(1);
+    let kind = request.kind.clone();
+    let kind_str = kind.key().to_owned();
+    let mut commands = Vec::new();
+
+    let nightly_available = if worker_kind_requires_nightly(&kind) {
+        let preflight_task = ProofCommandTask::worker_nightly_preflight(&request, timeout_sec);
+        let preflight_spec = ProofCommandSpec {
+            argv: vec![
+                "cargo".to_owned(),
+                "+nightly".to_owned(),
+                "--version".to_owned(),
+            ],
+            env: BTreeMap::new(),
+        };
+        let preflight_lease = worker_resource_lease(
+            &request,
+            &revision,
+            timeout_sec,
+            Some("nightly-preflight: cargo +nightly --version".to_owned()),
+        );
+        match run_proof_command_receipt(
+            ProofCommandInvocation {
+                command_root: root,
+                out,
+                receipt_id: &request.id,
+                side: "nightly-preflight",
+                spec: &preflight_spec,
+                timeout_sec,
+                lease: &preflight_lease,
+                task_ledger: Some(&task_ledger),
+                task: Some(&preflight_task),
+                cleanup: None,
+            },
+            runner,
+        ) {
+            Ok(receipt) => {
+                let available = receipt.status == "passed";
+                commands.push(receipt);
+                available
+            }
+            Err(error) => {
+                let failure = format!("worker nightly preflight failed: {error:#}");
+                task_ledger.fail_pending_receipts(&failure)?;
+                task_ledger.write_artifacts(out)?;
+                return Err(error).context("execute worker nightly capability preflight");
+            }
+        }
+    } else {
+        false
+    };
+
+    let resolved = resolve_proof_command(&kind, &request.target, nightly_available);
+    let command_task = ProofCommandTask::worker(&request, timeout_sec);
+    let Some(cmd) = resolved else {
+        let reason = format!("executor adapter could not resolve {kind_str} intent");
+        task_ledger.decline_command(
+            &command_task,
+            TaskNonExecutionDisposition::Unsupported,
+            &reason,
+        )?;
+        let spec = ProofCommandSpec {
+            argv: Vec::new(),
+            env: BTreeMap::new(),
+        };
+        commands.push(skipped_proof_command_receipt_for_id(
+            out,
+            &request.id,
+            "head",
+            &spec,
+            "skipped",
+            reason.clone(),
+        )?);
+        let receipt = worker_proof_receipt(
+            &request,
+            &revision,
+            commands,
+            "skipped_unresolved".to_owned(),
+            reason,
+        );
+        let lease = worker_resource_lease(&request, &revision, timeout_sec, None);
+        if let Err(error) = publish_worker_proof_result(
+            out,
+            &request,
+            &lease,
+            &receipt,
+            &task_ledger,
+        ) {
+            let failure = format!("worker result publication failed: {error:#}");
+            task_ledger.fail_pending_receipts(&failure)?;
+            task_ledger.write_artifacts(out)?;
+            return Err(error).context("publish unresolved worker proof result");
+        }
+        task_ledger.write_artifacts(out)?;
+        println!(
+            "worker: proof request {kind_str} unresolved, receipt written to {}",
+            out.join("proof_receipt.json").display()
+        );
+        return Ok(());
+    };
+
+    let env_map: BTreeMap<String, String> = cmd.env.iter().cloned().collect();
+    let spec = ProofCommandSpec {
+        argv: cmd.argv.clone(),
+        env: env_map,
+    };
+    let command_summary = if worker_kind_requires_nightly(&kind) {
+        format!(
+            "nightly-preflight: cargo +nightly --version; head: {}",
+            cmd.argv.join(" ")
+        )
+    } else {
+        format!("head: {}", cmd.argv.join(" "))
+    };
+    let lease = worker_resource_lease(
+        &request,
+        &revision,
+        timeout_sec,
+        Some(command_summary),
+    );
+    let command_receipt = match run_proof_command_receipt(
+        ProofCommandInvocation {
+            command_root: root,
+            out,
+            receipt_id: &request.id,
+            side: "head",
+            spec: &spec,
+            timeout_sec,
+            lease: &lease,
+            task_ledger: Some(&task_ledger),
+            task: Some(&command_task),
+            cleanup: None,
+        },
+        runner,
+    ) {
+        Ok(receipt) => receipt,
+        Err(error) => {
+            let failure = format!("worker command failed before receipt publication: {error:#}");
+            task_ledger.fail_pending_receipts(&failure)?;
+            task_ledger.write_artifacts(out)?;
+            return Err(error).context("execute standalone worker proof command");
+        }
+    };
+    let result = classify_worker_proof_result(&kind, &command_receipt);
+    let reason = format!("{kind_str}: {result}");
+    commands.push(command_receipt);
+    let receipt = worker_proof_receipt(&request, &revision, commands, result, reason);
+
+    if let Err(error) = publish_worker_proof_result(
+        out,
+        &request,
+        &lease,
+        &receipt,
+        &task_ledger,
+    ) {
+        let failure = format!("worker result publication failed: {error:#}");
+        task_ledger.fail_pending_receipts(&failure)?;
+        task_ledger.write_artifacts(out)?;
+        return Err(error).context("publish standalone worker proof result");
+    }
+    task_ledger.write_artifacts(out)?;
     println!(
         "worker: proof request {} ({kind_str}) result '{}'; receipt written to {}",
         request.id,
         receipt.result,
-        receipt_path.display()
+        out.join("proof_receipt.json").display()
     );
     Ok(())
 }
