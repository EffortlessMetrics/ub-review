+    /// Fail receipt publication after execution has terminalized, then release
+    /// the admitted resources without pretending a durable receipt exists.
+    pub(crate) fn receipt_creation_failed_and_resources_released(
+        &self,
+        task: &ProofCommandTask,
+        reason: &str,
+    ) -> Result<()> {
+        let task_id = task.task_id()?;
+        {
+            let state = self
+                .state
+                .lock()
+                .map_err(|_| anyhow::anyhow!("proof task-ledger mutex poisoned"))?;
+            ensure!(
+                state.pending_receipts.contains(task_id.as_str()),
+                "proof task {} has no pending receipt to fail",
+                task_id.as_str()
+            );
+        }
+        let receipt_at = self.recorder.now()?;
+        self.recorder.append([
+            input(
+                &task_id,
+                TaskEvent::ReceiptCreationFailed {
+                    at: receipt_at,
+                    reason: canonical_reason(reason),
+                },
+            ),
+            input(
+                &task_id,
+                TaskEvent::ResourcesReleased {
+                    at: self.recorder.now()?,
+                },
+            ),
+        ])?;
+        let removed = self
+            .state
+            .lock()
+            .map_err(|_| anyhow::anyhow!("proof task-ledger mutex poisoned"))?
+            .pending_receipts
+            .remove(task_id.as_str());
+        ensure!(
+            removed,
+            "proof task {} pending receipt disappeared during failure reconciliation",
+            task_id.as_str()
+        );
+        Ok(())
+    }
+
