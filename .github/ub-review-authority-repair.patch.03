+            .map(|input| input.event)
+            .collect::<Vec<_>>();
+        ensure!(events.iter().any(|event| matches!(
+            event,
+            TaskEvent::CleanupFinished { .. }
+        )));
+        ensure!(!events.iter().any(|event| matches!(
+            event,
+            TaskEvent::ResourcesReleased { .. }
+        )));
+        Ok(())
+    }
